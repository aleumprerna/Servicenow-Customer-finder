# Required. Create an Apollo API key with organization-enrichment/search access.
APOLLO_API_KEY=your_apollo_api_key

# Chrome must already be running with this remote-debugging endpoint.
CHROME_CDP_URL=http://localhost:9222

# Reserved for a possible future login flow; not used by the normal attached-browser workflow.
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

INPUT_CSV=companies.csv
OUTPUT_CSV=companies_checked.csv

# Kept for compatibility/documentation. CDP attachment uses the already-open browser as-is.
HEADLESS=false

SEARCH_TIMEOUT_SECONDS=20
DELAY_BETWEEN_COMPANIES_SECONDS=2
MATCH_THRESHOLD=85
REVIEW_THRESHOLD=70
APOLLO_MATCH_THRESHOLD=80
APOLLO_TIMEOUT_SECONDS=20
APOLLO_MAX_RETRIES=3
SAVE_SCREENSHOTS=true
DEBUG_DIR=debug

# Optional JSON array. Add selectors that resolve directly to one element per returned customer name.
# SERVICENOW_RESULT_SELECTORS=[".customer-search-results .customer-name"]

# Local workflow application. n8n receives one POST for every ServiceNow "No" result.
# Leave N8N_WEBHOOK_URL blank while testing without n8n.
N8N_WEBHOOK_URL=
APP_BASE_URL=http://localhost:8000

# Microsoft Entra ID login (sample page: http://localhost:8000/login).
# Register http://localhost:8000/auth/callback as a Web redirect URI.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:8000/auth/callback
# Stable secret used to encrypt saved Microsoft token caches.
MICROSOFT_TOKEN_KEY=
# Optional PostgreSQL backing for Microsoft accounts only. The rest of the app
# continues to use data/workflow.db. Forward EC2 PostgreSQL to localhost:5433.
MSAL_DB_HOST=127.0.0.1
MSAL_DB_PORT=5433
MSAL_DB_NAME=outreachgpt
MSAL_DB_USER=outreachgpt
MSAL_DB_PASSWORD=
MSAL_DB_SCHEMA=sales_agent
# If MSAL_DB_PASSWORD is blank, the app can retrieve it transiently from EC2.
MSAL_SSH_KEY=C:\path\to\connect.pem
MSAL_SSH_HOST=ubuntu@your-ec2-host
MSAL_DB_CONTAINER=outreachgpt-postgress_db-1
# Required when saving a new token because sales_agent.msal_tokens.user_id is NOT NULL.
MSAL_USER_ID=
# Generate a stable random value for signed login sessions.
SESSION_SECRET=
# Set true when the application is served over HTTPS.
SESSION_HTTPS_ONLY=false
# Optional: n8n must send this value in the X-Workflow-Token header when posting a callback.
N8N_CALLBACK_TOKEN=

# Active LLM provider: OpenAI Responses API with GPT-5.6 Luna.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.6-luna

# Optional monitoring rates in USD. Set these to the prices for the active provider/model.
# If left blank, tokens and latency are still tracked and cost is shown as unconfigured.
LLM_INPUT_COST_PER_MILLION=
LLM_CACHED_INPUT_COST_PER_MILLION=
LLM_OUTPUT_COST_PER_MILLION=
LLM_WEB_SEARCH_COST_PER_CALL=

# Preserved alternative: Gemini with native Google Search grounding and URL context.
GEMINI_API_KEY=
# GEMINI_KEY= is also accepted as an alias.
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_MAX_RETRIES=4
GEMINI_RETRY_BASE_SECONDS=2

# Preserved alternative: GLM through TokenRouter.
GLM_KEY=
GLM_BASE_URL=https://api.tokenrouter.com/v1
GLM_MODEL=z-ai/glm-5.3

# Preserved alternative: KIE's Responses-compatible endpoint.
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai/codex/v1
KIE_MODEL=gpt-6-astra
KIE_REASONING_EFFORT=high

# Legacy deep-research model setting retained for compatibility.
DEEP_RESEARCH_MODEL=gpt-5.6-luna
DEEP_RESEARCH_MAX_PAGES=12
DEEP_RESEARCH_PAGE_TIMEOUT_SECONDS=8
DEEP_RESEARCH_REQUEST_TIMEOUT_SECONDS=180
DEEP_RESEARCH_MAX_CONTENT_CHARS=250000
DEEP_RESEARCH_CACHE_DAYS=30
