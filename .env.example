# Required. Create an Apollo API key with organization-enrichment/search access.
APOLLO_API_KEY=your_apollo_api_key

# Chrome must already be running with this remote-debugging endpoint.
CHROME_CDP_URL=http://localhost:9222

# Reserved for a possible future login flow; not used by the normal attached-browser workflow.
SERVICENOW_USERNAME=
SERVICENOW_PASSWORD=

INPUT_CSV=companies.csv
OUTPUT_CSV=companies_checked.csv

# Kept for compatibility/documentation. CDP attachment uses the already-open browser as-is.
HEADLESS=false

SEARCH_TIMEOUT_SECONDS=20
DELAY_BETWEEN_COMPANIES_SECONDS=2
MATCH_THRESHOLD=85
REVIEW_THRESHOLD=70
APOLLO_MATCH_THRESHOLD=80
APOLLO_TIMEOUT_SECONDS=20
APOLLO_MAX_RETRIES=3
SAVE_SCREENSHOTS=true
DEBUG_DIR=debug

# Optional JSON array. Add selectors that resolve directly to one element per returned customer name.
# SERVICENOW_RESULT_SELECTORS=[".customer-search-results .customer-name"]

# Local workflow application. n8n receives one POST for every ServiceNow "No" result.
# Leave N8N_WEBHOOK_URL blank while testing without n8n.
N8N_WEBHOOK_URL=
APP_BASE_URL=http://localhost:8000
# Optional: n8n must send this value in the X-Workflow-Token header when posting a callback.
N8N_CALLBACK_TOKEN=

# Active LLM provider. GLM uses TokenRouter's OpenAI-compatible endpoint.
LLM_PROVIDER=glm
GLM_KEY=
GLM_BASE_URL=https://api.tokenrouter.com/v1
GLM_MODEL=z-ai/glm-5.3

# Kept for switching back later. This key is inactive while LLM_PROVIDER=glm.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Legacy deep-research model setting retained for compatibility.
DEEP_RESEARCH_MODEL=gpt-4o
DEEP_RESEARCH_MAX_PAGES=12
DEEP_RESEARCH_PAGE_TIMEOUT_SECONDS=8
DEEP_RESEARCH_REQUEST_TIMEOUT_SECONDS=180
DEEP_RESEARCH_MAX_CONTENT_CHARS=250000
DEEP_RESEARCH_CACHE_DAYS=30
